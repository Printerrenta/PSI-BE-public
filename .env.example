# Development branch Neon Auth and S3 values. Never paste production secrets into Git.
NEON_AUTH_BASE_URL=https://YOUR-DEV-AUTH-HOST/auth
NEON_AUTH_JWKS_URL=https://YOUR-DEV-AUTH-HOST/auth/jwks
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT_URL_S3=https://YOUR-DEV-STORAGE-HOST
AWS_REGION=eu-central-1
STORAGE_BUCKET=assets
API_PORT=8080
# Optional operator commands for a Neon-backed development stack:
# NEON_BRANCH=dev-microservices
# DATABASE_URL=postgresql://OWNER:PASSWORD@HOST-pooler/DB?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://OWNER:PASSWORD@HOST/DB?sslmode=require
